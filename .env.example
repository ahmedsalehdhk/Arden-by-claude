# Copy to .env.local for dev, or set on cPanel for prod.

# Postgres connection string.
# Local dev:  postgresql://ardenhol_ardenholdings:devpassword@localhost:5432/ardenhol_ardenholdings
# cPanel:     postgresql://ardenhol_USER:PASSWORD@HOST:5432/ardenhol_ardenholdings
DATABASE_URL=postgresql://ardenhol_ardenholdings:devpassword@localhost:5432/ardenhol_ardenholdings

# 32+ random chars. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Where uploaded images are physically written on disk.
# Local dev: a relative path resolved against the app cwd (e.g. public/uploads).
# cPanel:    an ABSOLUTE path outside the app directory so redeploys never wipe uploads,
#            e.g. /home/ardenhol/arden-uploads. Then symlink public/uploads → that folder.
UPLOAD_DIR=public/uploads
# Public URL prefix that serves UPLOAD_DIR. Only change this if you moved
# the symlink to a different name than /uploads.
UPLOAD_URL_PREFIX=/uploads

# Initial admin — only used by `npm run db:seed` when no users exist yet.
SEED_ADMIN_EMAIL=admin@ardenholdingsltd.com
SEED_ADMIN_PASSWORD=changemeonfirstlogin
SEED_ADMIN_NAME=Admin
